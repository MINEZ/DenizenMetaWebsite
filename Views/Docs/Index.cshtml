@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = Util.HeaderLine + " Website homepage.";
    ViewData["MetaColor"] = "#FFFFFF";
}

<span class="center_helper">
    <div class="jumbotron">
        <h1>@Util.HeaderLine Website</h1>
        <br>
        <br><h4>Documentation for the commands, tags, events and object types of <a href="https://github.com/MINEZ/Denizen">MINEZ/Denizen</a>, a fork of Denizen maintained for the MINEZ server.</h4>
        <br>
        <div class="alert alert-warning" role="alert">
            <b>This is not the official Denizen documentation.</b>
            <br>Some entries here differ from the official project, and some do not exist in it at all.
            <br>For the official documentation, see <a href="https://meta.denizenscript.com/" class="alert-link">meta.denizenscript.com</a>.
            <br>Please do not report anything you find here to the DenizenScript team &mdash; use <a href="https://github.com/MINEZ/Denizen/issues" class="alert-link">our issue tracker</a> instead.
        </div>
        <br><h5>This site documents the language, it does not teach it. If you're new to Denizen, follow <a href="https://guide.denizenscript.com/">The Beginner's Guide</a>, which covers the language as the official project ships it.</h5>
    </div>
</span>
